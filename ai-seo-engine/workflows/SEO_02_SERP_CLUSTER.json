    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data || \"\";\n\nconst titleMatches = [...html.matchAll(/<a[^>]*class=\"result__a\"[^>]*>(.*?)<\\/a>/g)];\n\nconst urlMatches = [...html.matchAll(/<a rel=\"nofollow\" class=\"result__a\" href=\"(.*?)\"/g)];\n\nconst titles = titleMatches\n  .slice(0, 5)\n  .map(m => m[1].trim());\n\nconst urls = urlMatches\n  .slice(0, 5)\n  .map(m => m[1]);\n\nreturn [\n  {\n    json: {\n      titles: titles.join(\" | \"),\n      urls: urls.join(\" | \")\n    }\n  }\n];"
      },
